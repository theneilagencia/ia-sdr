# Copie para .env e ajuste. Nenhuma destas variáveis vai para o frontend.
ENVIRONMENT=development
DEBUG=true

# Duas conexões, e a diferença entre elas é o que sustenta o isolamento.
#
# DATABASE_URL — role da APLICAÇÃO. Precisa ser NOSUPERUSER e NOBYPASSRLS:
#   superusuário ignora Row Level Security por completo (inclusive FORCE) e os
#   tenants passam a enxergar os dados uns dos outros. A API recusa subir se
#   esse role tiver privilégio demais.
# DATABASE_ADMIN_URL — role ADMINISTRATIVO, dono das tabelas e com BYPASSRLS.
#   Usado por migrations, bootstrap, autenticação e painel de plataforma.
#
# O role de aplicação é criado por `python -m scripts.bootstrap_roles`, que lê
# nome e senha da própria DATABASE_URL.
DATABASE_URL=postgresql+psycopg://ia_sdr_app:ia_sdr_app@localhost:5432/ia_sdr
DATABASE_ADMIN_URL=postgresql+psycopg://ia_sdr:ia_sdr@localhost:5432/ia_sdr

# Troque em produção. Em produção, venha de um secrets manager.
JWT_SECRET=change-me-in-production
# Assina os links de descadastro, que não expiram. Vazio herda o JWT_SECRET; em
# produção, gere um próprio para que rotacionar o JWT não mate link já enviado.
UNSUBSCRIBE_SECRET=
# Chave Fernet (32 bytes urlsafe-base64):
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRETS_ENCRYPTION_KEY=change-me-in-production

# IA. Cada empresa configura a própria chave na tela de Configurações; ela
# fica cifrada no banco e nunca volta para o frontend. As variáveis abaixo são
# só para desenvolvimento e para o caso de você querer operar com uma chave da
# plataforma (aí você paga o consumo de todos os tenants).
ANTHROPIC_API_KEY=
# Deixar um tenant sem chave usar a da plataforma. Desligado de propósito.
AI_PLATFORM_KEY_FALLBACK=false
AI_MODEL_DEFAULT=claude-opus-5
AI_EFFORT=high
AI_WEB_SEARCH=true
# Teto por execução, em micro-dólares (500000 = US$ 0,50). Passou disso, a
# execução falha explicitamente em vez de virar surpresa na fatura.
AI_MAX_COST_MICRO_USD=500000

ACCESS_TOKEN_TTL_MINUTES=720
RATE_LIMIT_REQUESTS=300
RATE_LIMIT_WINDOW_SECONDS=60
