# Copie para .env — ou deixe o publicar.sh gerar, que é mais seguro do que
# inventar senha à mão. Este arquivo é a única cópia das chaves: perder o
# SECRETS_ENCRYPTION_KEY significa perder o acesso a toda credencial de email
# e chave de API que as empresas já salvaram. Guarde um backup fora do servidor.

# Domínio onde a aplicação responde. Aponte um registro A do DNS para o IP
# deste servidor ANTES de subir: o certificado é emitido na primeira subida.
DOMAIN=app.suaempresa.com
# Para onde o Let's Encrypt avisa que o certificado vai expirar.
ACME_EMAIL=voce@suaempresa.com

# Banco. O role administrativo é superusuário; o de aplicação, não — e é essa
# diferença que faz o isolamento entre empresas valer (veja o compose).
DB_NAME=ia_sdr
DB_ADMIN_USER=ia_sdr_admin
DB_ADMIN_PASSWORD=
APP_DB_USER=ia_sdr_app
APP_DB_PASSWORD=

# openssl rand -base64 48
JWT_SECRET=
# Chave Fernet (32 bytes em base64 urlsafe):
#   openssl rand -base64 32 | tr '+/' '-_'
SECRETS_ENCRYPTION_KEY=

# Assina os links de descadastro, que não expiram. Separado do JWT_SECRET de
# propósito: rotacionar o segredo dos tokens de sessão (o que se faz depois de um
# vazamento) não pode matar todo descadastro já enviado. **Não rotacione este.**
#   openssl rand -base64 32
UNSUBSCRIBE_SECRET=

# Opcional: chave da Anthropic da plataforma. Deixe vazio para que cada empresa
# configure a própria pela tela de Configurações. Se preencher, ligue o fallback
# abaixo apenas se você pretende pagar o consumo dos clientes.
ANTHROPIC_API_KEY=
AI_PLATFORM_KEY_FALLBACK=false
